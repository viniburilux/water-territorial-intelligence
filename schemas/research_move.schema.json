    "schema_version": {"type": "string"}, "move_id": {"type": "string"}, "investigation_id": {"type": "string"}, "title": {"type": "string"}, "objective": {"type": "string"}, "action_type": {"type": "string"}, "action": {"type": "string"}, "rationale": {"type": "string"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}, "gap_ids": {"type": "array", "items": {"type": "string"}}, "expected_observation": {"type": ["string", "null"]}, "stop_criteria": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["proposed", "accepted", "completed", "rejected", "blocked"]},
    "source_observed_at": {"type": ["string", "null"], "format": "date-time"}, "generated_at": {"type": ["string", "null"], "format": "date-time"}, "provenance_note": {"type": ["string", "null"]}
  }
